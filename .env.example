# ============================================================
# AI Evaluation Harness — environment configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Required ---
GROQ_API_KEY=your_groq_api_key_here

# --- Optional: LLM settings ---
# Model to use for both generation and LLM judge calls.
# Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: Evaluation settings ---
# Whether to run the LLM-as-a-judge evaluator (uses API credits).
# Set to false to run only semantic + lexical metrics.
# Default: true
# RUN_LLM_JUDGE=true

# Max concurrent LLM calls (applies to both generation + judge calls).
# Default: 5
# EVAL_CONCURRENCY=5

# Per-call timeout in seconds.
# Default: 30
# EVAL_TIMEOUT_SECONDS=30

# Number of retries on rate-limit errors (exponential backoff).
# Default: 2
# EVAL_MAX_RETRIES=2

# --- Optional: Embedding model ---
# sentence-transformers model name.
# Default: all-MiniLM-L6-v2
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Optional: Persistence ---
# Path to the SQLite database file.
# Default: eval_runs.db (created in the project root)
# DB_PATH=eval_runs.db

# --- Optional: API settings ---
# Comma-separated allowed CORS origins.
# Default: localhost origins only
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
